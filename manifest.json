{
  "name": "Copy text with Alt-Click",
  "version": "2.4.0",
  "manifest_version": 3,
  "description": "Copy text with Alt-Click. Easy and fast copy tool.",
  "default_locale": "en",
  
  "permissions" : [
    "activeTab",
    "scripting",
    "storage", 
    "clipboardWrite",
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*", 
    "https://*/*"
  ],
  
  "icons" : {
    "48" : "icon.png"
  },
  
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "commands": {
    "copy-focused-target": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Copy hovered or focused target"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
